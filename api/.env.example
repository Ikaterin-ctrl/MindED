# MindED API — Environment Variables
# Copy this file to .env and fill in your values. NEVER commit .env to git.

# Gemini API key — get one at https://aistudio.google.com/app/apikey
# Use a key with billing enabled in production: Google's terms say not to send
# sensitive or personal information to the unpaid tier.
GEMINI_API_KEY=your_gemini_api_key_here

# Optional — defaults shown
# GEMINI_MODEL=gemini-3.8-flash
# FIREBASE_PROJECT_ID=minded-3d49a
# MAX_TEXT_CHARS=60000
# RATE_LIMIT_PER_MINUTE=10
# DAILY_CHAR_LIMIT=400000
# VIDEO_DAILY_LIMIT=5
# VIDEO_MAX_SECONDS=1800
# ALLOWED_ORIGINS=https://minded-3d49a.web.app,https://minded-3d49a.firebaseapp.com

# Local development only: accepts requests without a Firebase login.
# Never set this in production.
# AUTH_DISABLED=true
