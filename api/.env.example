# MindED API — Environment Variables
# Copy this file to .env and fill in your values. NEVER commit .env to git.

# Claude API key — create one at https://console.anthropic.com (API usage is billed
# separately from a Claude.ai Pro/Max plan, which does not include API access)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional — defaults shown
# CLAUDE_MODEL=claude-opus-5-5
# FIREBASE_PROJECT_ID=minded-3d49a
# MAX_TEXT_CHARS=60000
# RATE_LIMIT_PER_MINUTE=10
# DAILY_CHAR_LIMIT=400000
# GUEST_DAILY_REQUESTS=6
# GUEST_IP_DAILY_REQUESTS=20
# GUEST_MAX_CHARS=4000
# ALLOWED_ORIGINS=https://minded-3d49a.web.app,https://minded-3d49a.firebaseapp.com

# Local development only: accepts requests without a Firebase login.
# Never set this in production.
# AUTH_DISABLED=true
